{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:parseEuropeanNumber": "npx esbuild --bundle --platform=node --format=cjs src/lib/parseEuropeanNumber.test.ts | node",
    "test:groupIntoRows": "npx esbuild --bundle --platform=node --format=cjs src/lib/groupIntoRows.test.ts | node",
    "test:detectColumnMap": "npx esbuild --bundle --platform=node --format=cjs src/lib/detectColumnMap.test.ts | node",
    "test:classifyTransactionRows": "npx esbuild --bundle --platform=node --format=cjs src/lib/classifyTransactionRows.test.ts | node",
    "test:extractStructural": "npx esbuild --bundle --platform=node --format=cjs src/lib/extractStructural.test.ts | node",
    "test:extraction": "npx esbuild --bundle --platform=node --format=cjs src/lib/bankExtraction.test.ts | node",
    "test:extractStructuralPdfBuffer": "npx esbuild --bundle --platform=node --format=esm --packages=external src/lib/extractStructuralPdfBuffer.test.ts --outfile=.tmp-extractStructuralPdfBuffer.mjs && node .tmp-extractStructuralPdfBuffer.mjs",
    "test:reconcileStructuralTransactions": "npx esbuild --bundle --platform=node --format=cjs src/lib/reconcileStructuralTransactions.test.ts | node",
    "test:extractStructuralControls": "npx esbuild --bundle --platform=node --format=cjs src/lib/extractStructuralControls.test.ts | node",
    "test:postProcessBankTransactions": "npx esbuild --bundle --platform=node --format=cjs src/lib/postProcessBankTransactions.test.ts | node",
    "test:parseBankCsv": "npx esbuild --bundle --platform=node --format=cjs src/lib/parseBankCsv.test.ts | node",
    "test:moneyMetrics": "npx esbuild --bundle --platform=node --format=cjs src/lib/computeMoneyMetrics.test.ts | node",
    "test:bankImport": "npx esbuild --bundle --platform=node --format=cjs src/lib/bankImport.test.ts | node",
    "test:pdfMultiPageImportPipeline": "npx esbuild --bundle --platform=node --format=esm --packages=external src/lib/pdfMultiPageImportPipeline.test.ts --outfile=.tmp-pdfMultiPageImportPipeline.mjs && node .tmp-pdfMultiPageImportPipeline.mjs",
    "test:pdfModelOutputTruncation": "npx esbuild --bundle --platform=node --format=cjs src/lib/pdfModelOutputTruncation.test.ts | node",
    "test:pdfBatchedExtraction": "npx esbuild --bundle --platform=node --format=esm --packages=external src/lib/pdfBatchedExtraction.test.ts --outfile=.tmp-pdfBatchedExtraction.mjs && node .tmp-pdfBatchedExtraction.mjs",
    "test:bankImportRevalidate": "npx esbuild --bundle --platform=node --format=esm --packages=external src/lib/bankImportRevalidate.test.ts --outfile=.tmp-bankImportRevalidate.mjs && node .tmp-bankImportRevalidate.mjs",
    "test:planDraftValidation": "npx esbuild --bundle --platform=node --format=cjs src/lib/planDraftValidation.test.ts | node",
    "test:validateChatRequest": "npx esbuild --bundle --platform=node --format=cjs src/lib/validateChatRequest.test.ts | node",
    "test:evaluateFinishReason": "npx esbuild --bundle --platform=node --format=cjs src/lib/evaluateFinishReason.test.ts | node",
    "test:actionsDiagnosticLog": "npx esbuild --bundle --platform=node --format=cjs src/lib/actionsDiagnosticLog.test.ts | node",
  "test": "pnpm run test:parseEuropeanNumber && pnpm run test:groupIntoRows && pnpm run test:extraction && pnpm run test:planDraftValidation && pnpm run test:validateChatRequest && pnpm run test:evaluateFinishReason && pnpm run test:actionsDiagnosticLog"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "openai": "^7.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^0.1.80"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
